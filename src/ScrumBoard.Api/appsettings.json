{
  "ConnectionStrings": {
    "Database": "Host=localhost;Port=5432;Database=scrumboard;Username=scrumboard;Password=scrumboard"
  },
  "Jwt": {
    "Issuer": "ScrumBoard.Api",
    "Audience": "ScrumBoard.Web",
    "SigningKey": "development-only-signing-key-change-in-production",
    "LifetimeMinutes": 30
  },
  "Password": {
    "Pepper": "scrumboard-development-pepper-only",
    "Iterations": 210000
  },
  "Cors": {
    "AllowedOrigins": [ "http://localhost:4200", "http://localhost:8080" ]
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.AspNetCore.Diagnostics.ExceptionHandlerMiddleware": "Critical",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  },
  "AllowedHosts": "*"
}
